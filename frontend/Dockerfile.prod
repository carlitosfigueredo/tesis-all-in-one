# ─────────────────────────────────────────
# Stage 1: Build — compila la SPA con Vite
# ─────────────────────────────────────────
FROM node:24-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# VITE_API_URL se deja vacio a proposito: el cliente axios cae en '/api'
# (ruta relativa), y Nginx hace de reverse proxy hacia el backend.
# Las site keys publicas se inyectan como build args.
ARG VITE_RECAPTCHA_SITE_KEY
ARG VITE_PAYPAL_CLIENT_ID
ENV VITE_RECAPTCHA_SITE_KEY=$VITE_RECAPTCHA_SITE_KEY
ENV VITE_PAYPAL_CLIENT_ID=$VITE_PAYPAL_CLIENT_ID

RUN npm run build

# ─────────────────────────────────────────
# Stage 2: Runtime — Nginx sirve el build estatico
#          y hace de reverse proxy hacia el backend
# ─────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Config de Nginx (SPA fallback + proxy /api -> backend)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiar el build estatico generado en el stage anterior
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
