PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://tesis_user:tesis_pass@localhost:5432/tesis_bi_db
JWT_SECRET=cambia_esto_en_produccion_minimo_32_chars

# SMTP — desarrollo con Mailhog (docker-compose)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sistema BI <noreply@sistemabi.edu.py>"

# URL del frontend (para links en correos)
FRONTEND_URL=http://localhost:5173

# PostgreSQL (para docker-compose)
POSTGRES_USER=tesis_user
POSTGRES_PASSWORD=tesis_pass
POSTGRES_DB=tesis_bi_db
POSTGRES_PORT=5432

# Puertos expuestos
BACKEND_PORT=4000
FRONTEND_PORT=5173

# reCAPTCHA v2 (obtener keys en https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=tu_site_key_aqui
RECAPTCHA_SECRET_KEY=tu_secret_key_aqui

# PayPal Sandbox (obtener en https://developer.paypal.com)
# Crear una app en el Dashboard de PayPal Developer → Sandbox
PAYPAL_CLIENT_ID=tu_paypal_client_id_sandbox
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_sandbox
PAYPAL_ENVIRONMENT=SANDBOX

# Tasa de conversion PYG → USD para PayPal (1 USD = X guaranies)
PYG_TO_USD_RATE=7500

# Webhook ID — se obtiene al registrar la URL en developer.paypal.com → Apps → Webhooks
# Formato: WH-XXXXXXXXXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXX
PAYPAL_WEBHOOK_ID=tu_webhook_id_aqui
