PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://tesis_user:tesis_pass@localhost:5432/tesis_bi_db
JWT_SECRET=cambia_esto_en_produccion_minimo_32_chars
# Duracion de la sesion (JWT). Acepta: 15m, 1h, 8h, 7d, o segundos. Default: 8h
JWT_EXPIRES_IN=8h

# SMTP — Envío de correos
# DESARROLLO (por defecto): Mailhog (docker-compose). Revisá los correos en http://localhost:8025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sistema BI <noreply@sistemabi.edu.py>"
#
# PRODUCCIÓN / PRUEBAS REALES con Gmail:
#   Gmail NO acepta tu contraseña normal. Requiere una "Contraseña de aplicación" (16 dígitos):
#     1. Activá la verificación en 2 pasos: https://myaccount.google.com/security
#     2. Generá la app password: https://myaccount.google.com/apppasswords
#     3. Copiá los 16 caracteres SIN espacios en SMTP_PASS
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tucorreo@gmail.com
#   SMTP_PASS=xxxxxxxxxxxxxxxx
#   SMTP_FROM="Sistema BI <tucorreo@gmail.com>"

# URL del frontend (para links en correos)
FRONTEND_URL=http://localhost:5173

# PostgreSQL (para docker-compose)
POSTGRES_USER=tesis_user
POSTGRES_PASSWORD=tesis_pass
POSTGRES_DB=tesis_bi_db
POSTGRES_PORT=5432

# Puertos expuestos
BACKEND_PORT=4000
FRONTEND_PORT=5173

# reCAPTCHA v2 (obtener keys en https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=tu_site_key_aqui
RECAPTCHA_SECRET_KEY=tu_secret_key_aqui

# PayPal Sandbox (obtener en https://developer.paypal.com)
# Crear una app en el Dashboard de PayPal Developer → Sandbox
PAYPAL_CLIENT_ID=tu_paypal_client_id_sandbox
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_sandbox
PAYPAL_ENVIRONMENT=SANDBOX

# Tasa de conversion PYG → USD para PayPal (1 USD = X guaranies)
PYG_TO_USD_RATE=7500

# Webhook ID — se obtiene al registrar la URL en developer.paypal.com → Apps → Webhooks
# Formato: WH-XXXXXXXXXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXX
PAYPAL_WEBHOOK_ID=tu_webhook_id_aqui

# AdamsPay — Pasarela local Paraguay (https://adamspay.com)
# STAGING = ambiente de pruebas / PRODUCTION = produccion
ADAMSPAY_API_KEY=tu_adamspay_api_key
ADAMSPAY_API_SECRET=tu_adamspay_api_secret
ADAMSPAY_ENVIRONMENT=STAGING
