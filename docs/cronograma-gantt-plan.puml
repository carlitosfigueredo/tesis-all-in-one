@startgantt cronograma-plan-actividades
' =====================================================================
'  Diagrama de Gantt - Plan de Actividades de Tesis (Tabla 6)
'  BI + ML para predicción de fuga de talento
'  Alineado al Cronograma Académico de Tesis - UNIDA Fac. Ingeniería 2026
'  Rango: enero -> noviembre 2026 (cierra con la defensa)
' =====================================================================

language es
Project starts 2026-01-26
printscale monthly

' ---------- Estética ----------
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

<style>
ganttDiagram {
  task {
    FontName "Segoe UI"
    FontColor #0F172A
    BackGroundColor #1B3A7A
    LineColor #0D1B3E
  }
  milestone {
    BackGroundColor #E11D48
    LineColor #881337
    FontColor #0D1B3E
    FontStyle bold
  }
  separator {
    BackGroundColor #0D1B3E
    FontColor #FFFFFF
    FontStyle bold
  }
}
</style>

' Colores por tipo de actividad:
'   #2563EB azul  -> hito/gestión académica oficial (UNIDA)
'   #1B3A7A azul oscuro -> análisis y diseño
'   #0E7490 teal  -> Backend
'   #7C3AED violeta -> Servicio ML
'   #B45309 ámbar -> Frontend
'   #15803D verde -> integración y pruebas
'   #64748B gris  -> documentación

