# ══════════════════════════════════════════════════════════════
# Variables de entorno — PRODUCCION (EC2 + Cloudflare + Gmail)
#
# Copiar a .env.prod en la instancia y completar los valores.
#   cp .env.prod.example .env.prod
#   nano .env.prod
#
# NO subir .env.prod a git.
# ══════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────
NODE_ENV=production

# Reemplazar por TU dominio real de Cloudflare (con https://).
# Se usa para CORS del backend y para los links en los correos.
FRONTEND_URL=https://tudominio.com

# ── Base de datos PostgreSQL (solo red interna Docker) ───────
POSTGRES_USER=tesis_user
# Cambia esto por una contrasena fuerte y unica:
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD_FUERTE
POSTGRES_DB=tesis_bi_db

# El host es `postgres` (nombre del servicio en la red Docker), NO localhost.
DATABASE_URL=postgresql://tesis_user:CAMBIA_ESTA_PASSWORD_FUERTE@postgres:5432/tesis_bi_db

# ── Seguridad ────────────────────────────────────────────────
# Generar uno nuevo con:  openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRET_ALEATORIO_LARGO

# ── reCAPTCHA v2 ─────────────────────────────────────────────
# En la consola de Google reCAPTCHA agrega tu dominio a la lista de dominios permitidos.
RECAPTCHA_SITE_KEY=tu_site_key
RECAPTCHA_SECRET_KEY=tu_secret_key

# ── Correo: Gmail SMTP (demo de tesis) ───────────────────────
# Requiere verificacion en 2 pasos activada en la cuenta de Google
# y una "Contrasena de aplicacion" de 16 caracteres (sin espacios).
# Generar en: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=laappasswordde16caracteres
SMTP_FROM="Sistema BI <tucorreo@gmail.com>"

# ── PayPal ───────────────────────────────────────────────────
PAYPAL_CLIENT_ID=tu_paypal_client_id
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_WEBHOOK_ID=tu_webhook_id
PYG_TO_USD_RATE=7500
# Mismo Client ID publico para el SDK del frontend (se inyecta en build):
VITE_PAYPAL_CLIENT_ID=tu_paypal_client_id

# ── AdamsPay ─────────────────────────────────────────────────
ADAMSPAY_API_KEY=tu_adamspay_api_key
ADAMSPAY_API_SECRET=tu_adamspay_api_secret
ADAMSPAY_ENVIRONMENT=STAGING
